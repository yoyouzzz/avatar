// ==UserScript==
// @name         ハンゲ クローゼット全カテゴリ全件JSON出力
// @namespace    https://puretomo.hange.jp/
// @version      2.0.0
// @description  メインカテゴリ・サブカテゴリ・全ページを巡回してJSON出力
// @match        https://puretomo.hange.jp/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    const MAIN_CATEGORIES = [
        '衣装',
        'ヘアスタイル',
        '雑貨',
        'ペット',
        '背景＆エフェクト',
        'フェイス'
    ];

    let running = false;

    const sleep = ms =>
        new Promise(resolve => setTimeout(resolve, ms));

    function normalizeText(value) {
        return String(value || '')
            .replace(/\s+/g, '')
            .replace(/&/g, '＆')
            .trim();
    }

    function getCurrentItems() {
        return [...document.querySelectorAll(
            'div[class*="itemList_dispWrap"]'
        )]
            .map(item => {
                const img = item.querySelector('img');
                const p = item.querySelector('p');

                const name =
                    img?.alt?.trim() ||
                    p?.textContent?.trim() ||
                    '';

                const image =
                    img?.currentSrc ||
                    img?.src ||
                    '';

                const idMatch = image.match(
                    /\/([^/?#]+)\.(?:gif|png|jpe?g|webp)(?:[?#]|$)/i
                );

                return {
                    id: idMatch?.[1] || '',
                    name,
                    image
                };
            })
            .filter(item => item.name && item.image);
    }

    function getFirstImage() {
        return getCurrentItems()[0]?.image || '';
    }

    function getCurrentPage() {
        const current = document.querySelector(
            'button[aria-current="true"], button.Mui-selected'
        );

        if (!current) return 1;

        const label = current.getAttribute('aria-label') || '';
        const match = label.match(/page\s*(\d+)/i);

        if (match) return Number(match[1]);

        const number = Number(current.textContent?.trim());
        return Number.isFinite(number) ? number : 1;
    }

    function findNextButton() {
        return document.querySelector(
            'button[aria-label="Go to next page"]'
        ) || [...document.querySelectorAll('button')].find(button =>
            /next page/i.test(
                button.getAttribute('aria-label') || ''
            )
        );
    }

    function isDisabled(button) {
        return !button ||
            button.disabled ||
            button.getAttribute('aria-disabled') === 'true' ||
            button.classList.contains('Mui-disabled');
    }

    async function waitForChange(
        previousImage,
        previousPage,
        timeout = 15000
    ) {
        const start = Date.now();

        while (Date.now() - start < timeout) {
            await sleep(300);

            const items = getCurrentItems();
            const currentImage = items[0]?.image || '';
            const currentPage = getCurrentPage();

            if (
                items.length > 0 &&
                (
                    currentImage !== previousImage ||
                    currentPage !== previousPage
                )
            ) {
                await sleep(700);
                return true;
            }
        }

        await sleep(1000);
        return false;
    }

    function findMainCategoryButton(name) {
        const target = normalizeText(name);

        return [...document.querySelectorAll(
            'ul[class*="closet_categoryTab"] > li > button'
        )].find(button =>
            normalizeText(button.textContent) === target
        );
    }

    function getSubCategoryButtons() {
        return [...document.querySelectorAll(
            'ul[class*="closet_categorySubTab"] > li > button'
        )];
    }

    function getSubCategoryNames() {
        return getSubCategoryButtons()
            .map(button => button.textContent?.trim())
            .filter(Boolean);
    }

    function findSubCategoryButton(name) {
        const target = normalizeText(name);

        return getSubCategoryButtons().find(button =>
            normalizeText(button.textContent) === target
        );
    }

    async function clickAndWait(button) {
        if (!button) {
            throw new Error('クリック対象が見つかりません。');
        }

        const previousImage = getFirstImage();
        const previousPage = getCurrentPage();

        button.click();

        await waitForChange(
            previousImage,
            previousPage
        );

        await sleep(600);
    }

    async function openMainCategory(name) {
        const button = findMainCategoryButton(name);

        if (!button) {
            throw new Error(
                `メインカテゴリ「${name}」が見つかりません。`
            );
        }

        await clickAndWait(button);
    }

    async function openSubCategory(name) {
        const button = findSubCategoryButton(name);

        if (!button) {
            throw new Error(
                `サブカテゴリ「${name}」が見つかりません。`
            );
        }

        await clickAndWait(button);
    }

    async function collectCurrentSubCategory(
        mainCategory,
        subCategory,
        allItems,
        seen
    ) {
        let safety = 0;

        while (true) {
            safety += 1;

            if (safety > 1000) {
                throw new Error(
                    `${mainCategory} / ${subCategory}で処理回数が上限を超えました。`
                );
            }

            await sleep(400);

            const page = getCurrentPage();
            const items = getCurrentItems();

            for (const item of items) {
                const key = item.image;

                if (seen.has(key)) continue;

                seen.add(key);

                allItems.push({
                    category: mainCategory,
                    subcategory: subCategory,
                    page,
                    id: item.id,
                    name: item.name,
                    image: item.image
                });
            }

            updateStatus(
                `${mainCategory} ＞ ${subCategory} ＞ ${page}ページ ` +
                `（合計${allItems.length}件）`
            );

            const nextButton = findNextButton();

            if (isDisabled(nextButton)) {
                break;
            }

            const previousImage = getFirstImage();
            const previousPage = getCurrentPage();

            nextButton.click();

            await waitForChange(
                previousImage,
                previousPage
            );

            const newImage = getFirstImage();
            const newPage = getCurrentPage();

            if (
                newImage === previousImage &&
                newPage === previousPage
            ) {
                console.warn(
                    `${mainCategory} / ${subCategory}：ページが変わらないため終了`
                );
                break;
            }
        }
    }

    function downloadJson(data) {
        const blob = new Blob(
            [JSON.stringify(data, null, 2)],
            { type: 'application/json;charset=utf-8' }
        );

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        const now = new Date();

        const date = [
            now.getFullYear(),
            String(now.getMonth() + 1).padStart(2, '0'),
            String(now.getDate()).padStart(2, '0')
        ].join('-');

        link.href = url;
        link.download = `avatars-${date}.json`;

        document.body.appendChild(link);
        link.click();
        link.remove();

        setTimeout(() => URL.revokeObjectURL(url), 1500);
    }

    function updateStatus(text) {
        const status =
            document.getElementById('avatar-export-status');

        if (status) {
            status.textContent = text;
        }

        console.log(`[アバター取得] ${text}`);
    }

    async function exportEverything() {
        if (running) {
            alert('現在取得中です。');
            return;
        }

        running = true;

        const button =
            document.getElementById('avatar-export-button');

        if (button) {
            button.disabled = true;
            button.textContent = '取得中…';
        }

        const allItems = [];
        const seen = new Set();

        try {
            updateStatus('取得開始');

            for (const mainCategory of MAIN_CATEGORIES) {
                updateStatus(`${mainCategory}へ移動中`);

                await openMainCategory(mainCategory);

                /*
                 * メインカテゴリを開いたあとに表示される
                 * サブカテゴリ名を取得します。
                 */
                await sleep(500);

                const subCategories =
                    getSubCategoryNames();

                if (subCategories.length === 0) {
                    /*
                     * サブカテゴリがないカテゴリ用
                     */
                    await collectCurrentSubCategory(
                        mainCategory,
                        'すべて',
                        allItems,
                        seen
                    );

                    continue;
                }

                /*
                 * DOMは切替のたびに更新される可能性があるため、
                 * 最初に名前だけ保存して順番に再検索します。
                 */
                for (const subCategory of subCategories) {
                    updateStatus(
                        `${mainCategory} ＞ ${subCategory}へ移動中`
                    );

                    await openSubCategory(subCategory);

                    await collectCurrentSubCategory(
                        mainCategory,
                        subCategory,
                        allItems,
                        seen
                    );
                }
            }

            downloadJson(allItems);

            updateStatus(
                `完了：合計${allItems.length}件`
            );

            alert(
                `取得完了！\n合計${allItems.length}件を保存しました。`
            );

            console.table(allItems);

        } catch (error) {
            console.error(error);

            updateStatus('エラーで停止');

            alert(
                `途中で停止しました。\n\n${error.message}\n\n` +
                'Consoleの赤いエラーを確認してください。'
            );

        } finally {
            running = false;

            if (button) {
                button.disabled = false;
                button.textContent =
                    '全アバターをJSON保存';
            }
        }
    }

    function createPanel() {
        if (
            document.getElementById('avatar-export-panel')
        ) {
            return;
        }

        const panel = document.createElement('div');
        panel.id = 'avatar-export-panel';

        Object.assign(panel.style, {
            position: 'fixed',
            right: '18px',
            bottom: '18px',
            zIndex: '999999',
            padding: '12px',
            background: 'rgba(255,255,255,0.97)',
            border: '2px solid #ed91aa',
            borderRadius: '10px',
            boxShadow: '0 4px 16px rgba(0,0,0,0.2)',
            fontFamily: '"Noto Sans JP", sans-serif',
            textAlign: 'center'
        });

        const button = document.createElement('button');
        button.id = 'avatar-export-button';
        button.textContent = '全アバターをJSON保存';

        Object.assign(button.style, {
            padding: '10px 16px',
            border: 'none',
            borderRadius: '7px',
            background: '#ed91aa',
            color: '#fff',
            fontSize: '14px',
            fontWeight: '700',
            cursor: 'pointer'
        });

        button.addEventListener(
            'click',
            exportEverything
        );

        const status = document.createElement('div');
        status.id = 'avatar-export-status';
        status.textContent = '待機中';

        Object.assign(status.style, {
            marginTop: '7px',
            maxWidth: '280px',
            fontSize: '12px',
            color: '#555'
        });

        panel.appendChild(button);
        panel.appendChild(status);
        document.body.appendChild(panel);
    }

    const timer = setInterval(() => {
        const mainTabs = document.querySelector(
            'ul[class*="closet_categoryTab"]'
        );

        if (mainTabs) {
            clearInterval(timer);
            createPanel();
            console.log(
                '全カテゴリ・サブカテゴリ取得の準備完了'
            );
        }
    }, 1000);

})();
